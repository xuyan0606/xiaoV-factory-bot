# =============================================================================
# 科为博工厂数字化项目 — 环境变量模板
# 复制为 .env 文件并修改配置
# cp .env.example .env
# =============================================================================

# --- Flask 配置 ---
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-secret-key-change-in-production

# --- 钉钉机器人 ---
DINGTALK_TOKEN=crvab_factory_2026
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token_here

# --- 服务端口 ---
FLASK_PORT=5001
MQTT_PORT=1883
NGINX_PORT=80

# --- 数据库 ---
DB_PATH=/data/iot_data.db
KNOWLEDGE_DB_PATH=/data/knowledge_base.db

# --- Prometheus ---
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- 部署配置 ---
LOG_LEVEL=INFO
TZ=Asia/Shanghai
